# Ignore all experiments except example and integration tests
experiments/*
!experiments/example/
!experiments/integration_test/
!experiments/integration_test/**

# RStudio specific files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Ignore macOS DS_Store and metadata files (anywhere in the repository)
.DS_Store
._.DS_Store
**/.DS_Store
._*
**/._*



# Ignore example config files
experiments/example/config/generate_diann_spectral_library.cfg
experiments/example/config/run_diann.cfg

# Ignore database resources
experiments/example/input/database_resources/

# Ignore output files
output/
experiments/example/output/
!experiments/integration_test/output/
!experiments/integration_test/output/**

# Ignore logs files
experiments/example/logs/
experiments/example/config/

# Ignore any of the internal snakemake files
.snakemake

# Ignore any apptainer files
apptainer/*.sif

# Local credentials — never commit
tests/.env


# Ignore any raw files (except dry-run test fixtures and integration test data)
*.raw
!experiments/dry_run_test/**/*.raw
!tests/data/*.raw
!experiments/integration_test/input/ms_files/sample1.raw

# Python bytecode caches
__pycache__/
*.pyc

# Ignore any rust stuff
.cargo/
.rustup/
**/target/
.claude/
Rplots.pdf

# Ignore any database resources. Files are too large to be included in the repository.
# Exception: the manually-refined hapid HMM profile is a small, irreplaceable
# source asset (no rule regenerates it), so it is tracked via git-LFS. The `/*`
# form (instead of `resources/`) is required — git won't descend into a wholly
# excluded directory, so the negation below would otherwise have no effect.
resources/*
# Instructions for the user-supplied DIA-NN install (issue #63); everything
# they unzip alongside it stays ignored.
!resources/diann/
!resources/hapid/
resources/diann/*
!resources/diann/README.md
resources/hapid/*
!resources/hapid/ribP_elonF_profiles_refined_manually.hmm
!resources/hapid/PROVENANCE.md

*.fasta
*.speclib
*.raw
!experiments/dry_run_test/**/*.raw
!tests/data/*.raw
!experiments/integration_test/input/ms_files/sample1.raw
*.raw.quant
*.lz4
*.index

# DIA-NN sidecars (apply to any input format under ms_files/)
*.mzML.quant
*.mzML.pre.quant
*.raw.pre.quant

# Pipeline-generated test outputs (kept out of git; regenerated per run)
experiments/integration_test/runs/

# Workflow-generated outputs inside the peptidotyping smoke fixture
# (build_effective_detection_rank_db writes these into peptidotyping_resource_dir,
# which the smoke config points at tests/fixtures/peptidotyping_subset/).
# Inputs (allowlist.txt + the three rank TSVs) are committed; outputs aren't.
tests/fixtures/peptidotyping_subset/effective_*
tests/fixtures/peptidotyping_subset/family_rank_peptide_counts.tsv
tests/fixtures/peptidotyping_subset/taxid_to_family_genus.tsv
tests/fixtures/peptidotyping_subset/logs/

# bakta + check_genome_fastas leftovers under input/genome_files/ (the legacy
# input/MAG_files/ name is still accepted via the deprecated fallback)
experiments/*/input/genome_files/.fastas_checked
experiments/*/input/genome_files/logs/
experiments/*/input/MAG_files/.fastas_checked
experiments/*/input/MAG_files/logs/
# Samba/SMB temp files (Windows clients leave these when copying)
experiments/*/input/genome_files/.smb*
experiments/*/input/MAG_files/.smb*

# Local baseline / scratch archives dropped during refactor work
logs/

# Local driver scripts (not part of the workflow itself)
run_*.sh

# Rust specific files
.cargo/
.rustup/
**/target/

#

# DIA-NN default report.* output if any invocation is ever run without --out
/report.*
