# Ignore all experiments except example and integration tests
experiments/*
!experiments/example/
!experiments/integration_test/
!experiments/integration_test/**

# RStudio specific files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Ignore macOS DS_Store and metadata files (anywhere in the repository)
.DS_Store
._.DS_Store
**/.DS_Store
._*
**/._*



# Ignore example config files
experiments/example/config/generate_diann_spectral_library.cfg
experiments/example/config/run_diann.cfg

# Ignore database resources
experiments/example/input/database_resources/

# Ignore output files
output/
experiments/example/output/
!experiments/integration_test/output/
!experiments/integration_test/output/**

# Ignore logs files
experiments/example/logs/
experiments/example/config/

# Ignore any of the internal snakemake files
.snakemake

# Ignore any apptainer files
apptainer/*.sif

# Local credentials — never commit
tests/.env


# Ignore any raw files (except dry-run test fixtures and integration test data)
*.raw
!experiments/dry_run_test/**/*.raw
!tests/data/*.raw
!experiments/integration_test/input/raw_files/sample1.raw

# Ignore any rust stuff
.cargo/
.rustup/
**/target/
.claude/
Rplots.pdf

# Ignore any database resources. Files are too large to be included in the repository.
resources/

*.fasta
*.speclib
*.raw
!experiments/dry_run_test/**/*.raw
!tests/data/*.raw
!experiments/integration_test/input/raw_files/sample1.raw
*.raw.quant
*.lz4
*.index

# Rust specific files
.cargo/
.rustup/
**/target/

